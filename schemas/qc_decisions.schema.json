{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/tt-ecog/schemas/qc_decisions.schema.json",
  "title": "TT ECoG QC decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "subjects"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["pending", "approved"]},
    "created_at_utc": {"type": ["string", "null"]},
    "reviewed_by": {"type": ["string", "null"]},
    "approval_at_utc": {"type": ["string", "null"]},
    "qc_config_sha256": {"type": ["string", "null"]},
    "subjects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["S1", "S2", "S3"],
      "properties": {
        "S1": {"$ref": "#/$defs/subjectDecision"},
        "S2": {"$ref": "#/$defs/subjectDecision"},
        "S3": {"$ref": "#/$defs/subjectDecision"}
      }
    }
  },
  "$defs": {
    "subjectDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "excluded_channel_indices_0based", "intervals", "evidence_paths"],
      "properties": {
        "status": {"enum": ["pending", "approved"]},
        "original_channel_count": {"type": ["integer", "null"], "minimum": 1},
        "raw_data_sha256": {"type": ["string", "null"]},
        "excluded_channel_indices_0based": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "intervals": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["start_s", "end_s", "action", "reason"],
            "properties": {
              "start_s": {"type": "number", "minimum": 0},
              "end_s": {"type": "number", "exclusiveMinimum": 0},
              "action": {"enum": ["mask", "repair", "keep"]},
              "channel_indices_0based": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
              "reason": {"type": "string", "minLength": 1},
              "detector": {"type": ["string", "null"]},
              "evidence_paths": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "evidence_paths": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
